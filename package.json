{
  "name": "@majikah/majik-key-client-tauri",
  "version": "0.1.0",
  "description": "Typed TypeScript facade over tauri-plugin-majik-key-client: all keys and account state live in Rust, this class invokes them.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contract"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majikah/majik-key-client-tauri.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jedlsf"
  },
  "homepage": "https://github.com/Majikah/majik-key-client-tauri#readme",
  "bugs": {
    "url": "https://github.com/Majikah/majik-key-client-tauri/issues"
  },
  "scripts": {
    "update": "npm install @tauri-apps/api",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/api": ">=2.0.0",
    "@types/node": "^26.6.5",
    "typescript": ">=7.0.2",
    "vitest": ">=5.0.5"
  }
}